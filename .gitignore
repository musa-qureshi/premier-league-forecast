# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# --- Data (regeneratable from ingestion pipeline / too large to commit) ---
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
# Exception: matches.parquet is small (~230KB) and the deployed backend
# (Dockerfile) reads it directly at runtime with no ingestion pipeline
# available in that environment (no Kaggle credentials there, and
# football-data.co.uk is unreachable from this project's dev environment -
# see configs/data.yaml) - committing this one processed, already-cleaned
# file is simpler and more reliable than fetching it at build/boot time.
# features.parquet stays regeneratable-only; nothing at runtime needs it.
!data/processed/matches.parquet

# --- Kaggle credentials - never commit ---
kaggle.json
.kaggle/

# --- Notebooks ---
.ipynb_checkpoints/

# --- Frontend ---
app/frontend/node_modules/
app/frontend/dist/

# --- Env / secrets ---
.env
.env.local
app/frontend/.env*.local

# --- OS / IDE ---
.DS_Store
Thumbs.db
.vscode/
.idea/
